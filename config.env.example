# NixiTubeClock build-time configuration template
# Copy to config.env and adapt values.
# config.env is gitignored.

# Hardware profile:
#   MASTER_NO_RTC -> no RTC module, internet time source
#   RTC_LOCAL     -> RTC module, local time from RTC only
HARDWARE_PROFILE=MASTER_NO_RTC

# Tube type:
#   ZM1000, IN4, DA2000
TUBE_TYPE=ZM1000

# Optional: custom setup hotspot SSID
PROVISION_AP_NAME=NixiClockSetup

# Set to false to boot directly to saved WiFi credentials from config.env
# Set to true to always open the setup hotspot on boot (useful for debugging)
FORCE_PROVISIONING=false

# Time sync behavior for both hardware profiles
# Default: 10800 = 3 hours
WIFI_SYNC_SECONDS=10800
MAX_SYNC_FAILS=3

# OTA (optional): set to 1 to enable ArduinoOTA for a short boot window
ENABLE_OTA=0
OTA_WINDOW_SECONDS=180
OTA_HOSTNAME=NixiClock

# Time API base for city URL composition:
# final URL = TIME_API_BASE + CITY
TIME_API_BASE=https://timeapi.io/api/Time/current/zone?timeZone=

# Initial values used before first portal save.
# If these are valid and FORCE_PROVISIONING=0, the clock will skip the AP and join WiFi directly.
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD
CITY=Europe/Berlin
